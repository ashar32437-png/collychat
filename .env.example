# Optional — leave unset to run in demo mode (messages are kept in memory
# and reset whenever the server restarts).
#
# For real persistence, create a free Postgres database (e.g. neon.tech or a
# Supabase project's connection string), copy the pooled connection string, and
# set it here (locally) or in the Vercel project environment variables.
DATABASE_URL=

# ------------------------------------------------------------------ GIF picker
# Free key from https://developers.giphy.com/dashboard/. Without it the GIF
# picker shows setup instructions instead of results.
GIPHY_API_KEY=

# --------------------------------------------------------------------- storage
# Supabase Storage holds every uploaded picture; Postgres then keeps only the
# object URL, which is what keeps the database (and the 500 MB quota) small.
#
#   SUPABASE_URL          Project URL — https://<project-ref>.supabase.co
#   SUPABASE_SERVICE_KEY  Project Settings -> API keys -> secret key (server only)
#   SUPABASE_BUCKET       optional, defaults to "chat-uploads" (made public on
#                         first upload so the browser can load it from the CDN)
#
# Leave SUPABASE_URL empty and uploads fall back to storing bytes in the
# database, which works but costs database space instead.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=chat-uploads
